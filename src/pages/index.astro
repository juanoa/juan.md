---
import {
  ItemDescription,
  ItemContent,
  ItemTitle,
  Item,
  ItemMedia,
} from "@/components/ui/item";
import LogList from "@/components/logs/LogList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CollocationsLogo } from "@/components/projects/CollocationsLogo";
import { OnePointZeroOneLogo } from "@/components/projects/OnePointZeroOneLogo";
import { MitoHoverCard } from "@/components/index/hover-cards/MitoHoverCard";
import { InditexHoverCard } from "@/components/index/hover-cards/InditexHoverCard";
import { CorunaHoverCard } from "@/components/index/hover-cards/CorunaHoverCard";
import GitHubWeeklyContributions from "@/components/index/GitHubWeeklyContributions.astro";
import { Image } from "astro:assets";
import { ArrowUpRightIcon } from "@phosphor-icons/react/dist/ssr/ArrowUpRight";

const pageTitle = "Juan Otálora";
---

<BaseLayout pageTitle={pageTitle}>
  <article class="prose dark:prose-invert">
    <section>
      <h2>Work</h2>
      <p>
        I work on the engineering team at <MitoHoverCard
          text="MITO"
          client:load
        />. I was one of the company's first engineers. I like to craft
        interfaces and make them easy to use.
      </p>
      <div class="not-prose flex flex-col gap-2">
        <Image
          src="/mito-team.webp"
          alt="The MITO team"
          width={1536}
          height={685}
          widths={[320, 640, 960, 1200, 1536]}
          sizes="(max-width: 640px) calc(100vw - 3rem), 65ch"
          quality="high"
        />
        <p class="text-center text-xs">MITO Team. December 2025</p>
      </div>
      <p>
        I previously worked at <InditexHoverCard text="Inditex" client:load /> (zara.com).
      </p>
      <h2>About</h2>
      <p>
        I’ve always liked technology. I got my first computer when I was 5. It
        had no internet connection. I just messed around changing the settings.
      </p>
      <p>I started programming at 15.</p>
      <GitHubWeeklyContributions />
      <p>I like working with people who believe in what they do.</p>
      <p>
        I'm based in <CorunaHoverCard text="A Coruña" client:load />, Spain.
      </p>
      <p>Spending my free time climbing, surfing, or running.</p>
      <div class="not-prose flex flex-col gap-2">
        <div class="grid grid-cols-2 gap-2 sm:gap-4">
          <Image
            src="/torre-hercules.webp"
            alt="Hercules Tower in A Coruña"
            width={960}
            height={1281}
            widths={[320, 480, 640, 960]}
            sizes="(max-width: 640px) calc((100vw - 3.5rem) / 2), 32ch"
            quality="high"
            class="h-full object-cover"
          />
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Matadero Beach in A Coruña"
            class="h-full object-cover">
            <source src="/playa-matadero.webm" type="video/webm" />
          </video>
        </div>
        <p class="text-center text-xs">
          Left: Hercules Tower. Right: Matadero Beach. A Coruña
        </p>
      </div>
      <p>I also like to <a href="/trips">explore</a> new places.</p>
    </section>

    <section>
      <h2>Projects</h2>
      <div class="not-prose mt-6">
        <a href="https://www.onepointzeroone.dev/">
          <Item size="sm" className="group">
            <ItemMedia variant="image">
              <OnePointZeroOneLogo />
            </ItemMedia>
            <ItemContent className="gap-0">
              <ItemTitle>1.01^n</ItemTitle>
              <ItemDescription>
                An almanack of evergreen content for SWE
              </ItemDescription>
            </ItemContent>
            <ArrowUpRightIcon
              className="size-4 opacity-0 transition-opacity group-hover:opacity-100"
            />
          </Item>
        </a>
      </div>
      <div class="not-prose">
        <a href="https://collocations.juan.md">
          <Item size="sm" className="group">
            <ItemMedia variant="image">
              <CollocationsLogo />
            </ItemMedia>
            <ItemContent className="gap-0">
              <ItemTitle>Collocations</ItemTitle>
              <ItemDescription>
                A search engine for English collocations
              </ItemDescription>
            </ItemContent>
            <ArrowUpRightIcon
              className="size-4 opacity-0 transition-opacity group-hover:opacity-100"
            />
          </Item>
        </a>
      </div>
    </section>

    <section class="mt-10">
      <h2>Logs</h2>
      <LogList />
    </section>

    <section class="mt-20">
      <p class="*:no-underline">
        <a href="https://x.com/juanoa_">X</a> / <a
          href="https://linkedin.com/in/juanoa">LinkedIn</a
        > / <a href="https://github.com/juanoa">GitHub</a>
      </p>
    </section>
  </article>
</BaseLayout>
