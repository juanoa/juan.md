---
import { getCollection } from "astro:content";

const isProduction = import.meta.env.PROD;
const logDateFormatter = new Intl.DateTimeFormat("en", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const logDateYearFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  timeZone: "UTC",
});

function formatLogDate(date: Date) {
  return logDateFormatter.format(date);
}

const logs = (
  await getCollection(
    "logs",
    (entry) => !entry.id.includes("/") && (!isProduction || !entry.data.draft),
  )
).sort((left, right) => {
  const createdAtDifference =
    right.data.createdAt.getTime() - left.data.createdAt.getTime();

  if (createdAtDifference !== 0) {
    return createdAtDifference;
  }

  return left.data.title.localeCompare(right.data.title);
});
---

<ul class="not-prose mt-6 space-y-3">
  {
    logs.map((log) => (
      <li>
        <a href={`/${log.id}`} class="group block">
          <div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-2">
            <div class="flex min-w-0 items-baseline gap-1">
              <span class="group-hover:text-foreground min-w-0 truncate">
                {log.data.title}
              </span>
              <span
                aria-hidden="true"
                class="hidden min-w-0 flex-1 border-b-2 border-dotted transition-all sm:block"
              />
            </div>
            <time
              datetime={log.data.createdAt.toISOString().split("T")[0]}
              data-log-date
              class="text-muted-foreground group-hover:text-foreground shrink-0 font-mono text-xs font-normal transition-all sm:text-sm">
              <span data-log-date-year class="sm:hidden">
                {logDateYearFormatter.format(log.data.createdAt)}
              </span>
              <span data-log-date-full class="hidden sm:inline">
                {formatLogDate(log.data.createdAt)}
              </span>
            </time>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<script>
  const logDateFormatter = new Intl.DateTimeFormat(undefined, {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
  const logDateYearFormatter = new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    timeZone: "UTC",
  });

  document
    .querySelectorAll<HTMLTimeElement>("time[data-log-date]")
    .forEach((time) => {
      const date = new Date(`${time.dateTime}T00:00:00.000Z`);

      if (!Number.isNaN(date.valueOf())) {
        const year = time.querySelector<HTMLElement>("[data-log-date-year]");
        const fullDate = time.querySelector<HTMLElement>(
          "[data-log-date-full]",
        );

        if (year) {
          year.textContent = logDateYearFormatter.format(date);
        }

        if (fullDate) {
          fullDate.textContent = logDateFormatter.format(date);
        }
      }
    });
</script>
