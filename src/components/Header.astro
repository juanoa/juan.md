---
import { MitoLogo } from "@/components/MitoLogo";

const { isHomePage } = Astro.props;
---

<header class="mb-20">
  <nav class="text-lg">
    {
      isHomePage ? (
        <h1>
          <a href="/">Juan Otálora</a>
        </h1>
      ) : (
        <p>
          <a href="/">Juan Otálora</a>
        </p>
      )
    }
    <div class="inline-flex items-center gap-3.5 leading-none">
      <span class="text-muted-foreground">Engineer @</span>
      <a href="https://mito.ai" target="_blank">
        <MitoLogo
          className="text-muted-foreground h-3.5 w-auto transition-all hover:scale-105 hover:-rotate-5 hover:text-neutral-900"
        />
      </a>
    </div>
  </nav>
</header>
